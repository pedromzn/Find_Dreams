{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "template": {
      "default": "modern",
      "type": "string",
      "enum": [
        "modern",
        "harvard",
        "classic"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "pt-BR"
      ]
    },
    "basics": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "headline": {
          "default": "",
          "type": "string",
          "maxLength": 200
        },
        "location": {
          "default": "",
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "maxLength": 200,
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "phone": {
          "default": "",
          "type": "string",
          "maxLength": 40
        },
        "links": {
          "default": [],
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "url": {
                "type": "string",
                "maxLength": 2000,
                "format": "uri"
              }
            },
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "summary": {
      "default": "",
      "type": "string",
      "maxLength": 1200
    },
    "experience": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "location": {
            "default": "",
            "type": "string",
            "maxLength": 120
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2})?$"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2})?$"
          },
          "current": {
            "default": false,
            "type": "boolean"
          },
          "bullets": {
            "default": [],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        },
        "required": [
          "company",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "education": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "institution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "degree": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2})?$"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2})?$"
          },
          "notes": {
            "default": "",
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "institution",
          "degree"
        ],
        "additionalProperties": false
      }
    },
    "skills": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "items": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          }
        },
        "required": [
          "group",
          "items"
        ],
        "additionalProperties": false
      }
    },
    "languages": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "level": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "language",
          "level"
        ],
        "additionalProperties": false
      }
    },
    "certifications": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "issuer": {
            "default": "",
            "type": "string",
            "maxLength": 120
          },
          "year": {
            "default": "",
            "type": "string",
            "maxLength": 10
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "projects": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "url": {
            "type": "string",
            "maxLength": 2000,
            "format": "uri"
          }
        },
        "required": [
          "name",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "tailoring": {
      "type": "object",
      "properties": {
        "application": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "changes": {
          "default": [],
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "keywordsCovered": {
          "default": [],
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        }
      },
      "required": [
        "application"
      ],
      "additionalProperties": false
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "language",
    "basics",
    "generatedAt"
  ],
  "additionalProperties": false
}
