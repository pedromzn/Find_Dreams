{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "interviewType": {
      "type": "string",
      "enum": [
        "hr_screening",
        "technical",
        "client",
        "hiring_manager",
        "live_coding",
        "system_design",
        "take_home_review",
        "panel",
        "language",
        "final_executive",
        "case_study",
        "async_video"
      ]
    },
    "account": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "questionsAsked": {
      "default": [],
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "selfAssessment": {
      "type": "string",
      "enum": [
        "great",
        "good",
        "mixed",
        "bad"
      ]
    },
    "analysis": {
      "default": "",
      "type": "string",
      "maxLength": 4000
    },
    "adjustments": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "outcome": {
      "default": "pending",
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed",
        "unknown"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "pt-BR"
      ]
    }
  },
  "required": [
    "date",
    "interviewType",
    "account",
    "language"
  ],
  "additionalProperties": false
}
