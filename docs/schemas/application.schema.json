{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "company": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "seniority": {
      "type": "string",
      "enum": [
        "intern",
        "junior",
        "mid",
        "senior",
        "staff",
        "principal",
        "lead",
        "manager"
      ]
    },
    "url": {
      "type": "string",
      "maxLength": 2000,
      "format": "uri"
    },
    "source": {
      "type": "string",
      "enum": [
        "linkedin",
        "gupy",
        "greenhouse",
        "lever",
        "indeed",
        "referral",
        "other"
      ]
    },
    "location": {
      "default": "",
      "type": "string",
      "maxLength": 120
    },
    "workModel": {
      "type": "string",
      "enum": [
        "remote",
        "hybrid",
        "onsite"
      ]
    },
    "salary": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000000
        },
        "max": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000000
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "period": {
          "default": "month",
          "type": "string",
          "enum": [
            "hour",
            "month",
            "year"
          ]
        }
      },
      "required": [
        "currency"
      ],
      "additionalProperties": false
    },
    "salaryKind": {
      "type": "string",
      "enum": [
        "announced",
        "informed"
      ]
    },
    "contract": {
      "type": "string",
      "enum": [
        "clt",
        "pj",
        "contractor",
        "permanent",
        "temporary",
        "internship",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "saved",
        "applied",
        "screening",
        "interviewing",
        "offer",
        "accepted",
        "rejected",
        "withdrawn",
        "ghosted"
      ]
    },
    "stages": {
      "default": [],
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "hr_screening",
              "technical",
              "client",
              "hiring_manager",
              "live_coding",
              "system_design",
              "take_home_review",
              "panel",
              "language",
              "final_executive",
              "case_study",
              "async_video"
            ]
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "result": {
            "default": "scheduled",
            "type": "string",
            "enum": [
              "scheduled",
              "pending",
              "passed",
              "failed",
              "cancelled"
            ]
          },
          "notes": {
            "default": "",
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      }
    },
    "nextSteps": {
      "default": [],
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "what": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "due": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "done": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "what"
        ],
        "additionalProperties": false
      }
    },
    "pros": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "cons": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "notes": {
      "default": "",
      "type": "string",
      "maxLength": 5000
    },
    "contacts": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "name",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "appliedAt": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "slug",
    "company",
    "role",
    "source",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
