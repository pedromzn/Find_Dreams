# Copy to .env to change the defaults (Node reads it on its own, no dotenv).

# the dev server port (the desktop app picks a random free port instead)
# PORT=3060

# keep it on 127.0.0.1: the API serves personal data (CV, salary, recruiter messages)
# HOST=127.0.0.1

# where your data lives in dev (default: ./workspace, which git ignores)
# MZN_WORKSPACE=./workspace
